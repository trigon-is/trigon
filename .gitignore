# Runtime artifacts written by trigon-up.sh into the project root
.mcp.json
.mcp.json.backup

# Default output dirs created by --mode security
security-results/
wordlists/

# --audit wrote its log into the project root until 2026-10; it now goes to
# ${XDG_STATE_HOME:-~/.local/state}/trigon/audit/<project>/ (decision D7).
# Kept so logs from older sessions don't get committed.
audit-log/

# Python bytecode cache (e.g. from lib/ helper scripts)
__pycache__/
*.pyc

# Editor / OS noise
*.swp
*.swo
.DS_Store
